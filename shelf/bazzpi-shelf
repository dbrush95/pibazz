#!/bin/bash
set -uo pipefail
DEST="${BAZZPI_DEST:-/opt/bazzpi-shelf}"
# Migrate the original flat-file installation without losing its settings.
if [ ! -e "$DEST/current" ]; then
  mkdir -p "$DEST/releases/legacy"
  for file in index.html shelf.css shelf.js shelf.py update.sh bazzpi-shelf outfit.ttf; do
    [ ! -f "$DEST/$file" ] || cp "$DEST/$file" "$DEST/releases/legacy/$file"
  done
  ln -s "$DEST/releases/legacy" "$DEST/current"
fi
if [ "$(readlink -f "${BASH_SOURCE[0]}")" != "$(readlink -f "$DEST/current/bazzpi-shelf")" ]; then
  exec bash "$DEST/current/bazzpi-shelf"
fi
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/bazzpi"
mkdir -p "$STATE" "$HOME/.config/bazzpi"
exec 8>"${XDG_RUNTIME_DIR:-/tmp}/bazzpi-$(id -u).lock"
flock -n 8 || { wlrctl toplevel focus title:Bazzpi 2>/dev/null; exit 0; }
BOOT=$(cat /proc/sys/kernel/random/boot_id)
if [ "$(cat "$STATE/boot-id" 2>/dev/null)" != "$BOOT" ]; then
  printf '%s\n' "$BOOT" > "$STATE/boot-id"
  timeout 35 bash "$DEST/current/update.sh" >> "$STATE/update.log" 2>&1 || echo failed > "$STATE/update-status"
fi
ROOT=$(readlink -f "$DEST/current")
start_backend() {
  python3 "$ROOT/shelf.py" >> "$STATE/shelf.log" 2>&1 &
  BACKEND=$!
  for _ in $(seq 1 40); do
    if curl -fsS --max-time 1 http://127.0.0.1:8765/api/status >/dev/null; then return 0; fi
    kill -0 "$BACKEND" 2>/dev/null || break
    sleep 0.1
  done
  return 1
}
if ! start_backend; then
  kill "$BACKEND" 2>/dev/null || true
  wait "$BACKEND" 2>/dev/null || true
  if [ -d "$DEST/previous" ] && [ "$(readlink -f "$DEST/previous")" != "$ROOT" ]; then
    cat "$ROOT/revision" > "$STATE/rejected-revision" 2>/dev/null || true
    ln -sfn "$(readlink -f "$DEST/previous")" "$DEST/current.new"
    mv -Tf "$DEST/current.new" "$DEST/current"
    ROOT=$(readlink -f "$DEST/current")
    echo rollback > "$STATE/update-status"
    start_backend || exit 1
  else
    exit 1
  fi
fi
trap 'kill "$BACKEND" 2>/dev/null || true' EXIT
CHROME=$(command -v chromium || command -v chromium-browser) || exit 1
# Separate browser profiles prevent app windows attaching to the shelf process.
# The first upgraded run migrates preferences from the old default Chromium profile.
PROFILE="$HOME/.config/bazzpi-shelf-browser"
if [ ! -d "$PROFILE" ] && [ -d "$HOME/.config/chromium" ]; then
  cp -a "$HOME/.config/chromium" "$PROFILE"
  rm -f "$PROFILE"/Singleton*
fi
while kill -0 "$BACKEND" 2>/dev/null; do
  "$CHROME" --user-data-dir="$PROFILE" --class=bazzpi-shelf --ozone-platform=wayland \
    --kiosk --no-first-run --noerrdialogs --disable-session-crashed-bubble \
    --disable-background-mode --app=http://127.0.0.1:8765/ >> "$STATE/shelf.log" 2>&1
  sleep 1
done
